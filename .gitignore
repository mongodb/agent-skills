# Skill evaluation/benchmark workspaces
*-workspace/

# Output of testing/<skill>/run-trigger-eval.ts, regenerated on every run
testing/*/trigger-eval-results.json

# User-specific Claude settings
.claude/settings.local.json
.score_cache/

# Node tooling dependencies
node_modules/

.DS_Store

# OpenCode plugin packages: no lockfile. Consumers resolve their own dependencies,
# and CI type-checks against the latest @opencode/plugin in range.
plugins/*/pnpm-lock.yaml
